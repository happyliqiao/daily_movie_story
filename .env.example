# 每日影视故事梗概 —— 配置模板
# 复制为 .env 后填入自己的密钥：copy .env.example .env

# ===== 大模型接口（任意 OpenAI 兼容接口均可）=====
#
# 【方案一 · 免费】智谱 GLM-4-Flash —— 永久免费、无 Token 上限，只限 1 个并发
#   注册：https://open.bigmodel.cn → 注册并实名认证 → API Keys → 创建密钥
#   下面三行照抄即可（模型名如报错，试 glm-4.7-flash 或看平台文档的模型列表）
# MOVIE_API_KEY=你的智谱密钥
# MOVIE_API_BASE=https://open.bigmodel.cn/api/paas/v4
# MOVIE_MODEL=glm-4-flash
#
# 【方案二 · 付费但便宜】DeepSeek
#   注册：https://platform.deepseek.com → 充值 → API keys
# MOVIE_API_KEY=sk-xxx
# MOVIE_API_BASE=https://api.deepseek.com
# MOVIE_MODEL=deepseek-chat
#
# 换完之后先体检，别直接跑整部剧：
#   python scripts/check_api.py
MOVIE_API_KEY=sk-your-key-here
MOVIE_API_BASE=https://open.bigmodel.cn/api/paas/v4
MOVIE_MODEL=glm-4-flash

# ===== 输出位置 =====
MOVIE_OUTPUT_DIR=E:/liqiaobac/每日影视故事梗概

# ===== 分段规则 =====
# 电影：每多少分钟一段（默认 10，2 小时片 = 12 段）
MOVIE_SEGMENT_MINUTES=10
# 电视剧：每集拆几段（默认 2；单集超过 50 分钟自动用 3 段）
TV_SEGMENTS_PER_EPISODE=2

# ===== 生成参数 =====
MOVIE_TEMPERATURE=0.65
MOVIE_TIMEOUT=180
MOVIE_MAX_RETRIES=4
MOVIE_BATCH_SIZE=8
TV_BATCH_SIZE=6
# 单次输出上限。免费模型通常卡在 4096，程序会自动降级，也可在这里直接设小
# MOVIE_MAX_TOKENS=4096

# ===== 邮件发送 =====
# 163 邮箱请填「客户端授权码」，不是登录密码
MOVIE_SMTP_HOST=smtp.163.com
MOVIE_SMTP_PORT=465
MOVIE_SMTP_USER=your@163.com
MOVIE_SMTP_PASS=your-client-authorization-code
MOVIE_SMTP_TO=your@163.com
# 1 = 465 端口隐式 SSL；0 = 587 端口 STARTTLS
MOVIE_SMTP_SSL=1
